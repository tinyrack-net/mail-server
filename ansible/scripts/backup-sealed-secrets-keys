#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ANSIBLE_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
REPOSITORY_DIR="$(cd -- "${ANSIBLE_DIR}/.." && pwd)"
KUBE_CONTEXT="${KUBE_CONTEXT:-mail-server}"
CONTROLLER_NAMESPACE="${CONTROLLER_NAMESPACE:-sealed-secrets}"
CONTROLLER_NAME="${CONTROLLER_NAME:-sealed-secrets}"
VAULT_PASSWORD_FILE="${VAULT_PASSWORD_FILE:-${ANSIBLE_DIR}/.vault_pass}"
BACKUP_FILE="${ANSIBLE_DIR}/inventories/production/group_vars/all/sealed-secrets-keys.vault.yml"
CERTIFICATE_FILE="${REPOSITORY_DIR}/tinyrack-production-key.crt"

for command_name in ansible-vault jq kubectl kubeseal openssl; do
  command -v "${command_name}" >/dev/null
done

test -r "${VAULT_PASSWORD_FILE}"

backup_tmp_dir="$(mktemp -d)"
chmod 0700 "${backup_tmp_dir}"
trap 'rm -rf -- "${backup_tmp_dir}"' EXIT

keys_json="${backup_tmp_dir}/keys.json"
vault_plaintext="${backup_tmp_dir}/sealed-secrets-keys.yml"
vault_ciphertext="${backup_tmp_dir}/sealed-secrets-keys.vault.yml"
current_certificate="${backup_tmp_dir}/tinyrack-production-key.crt"

kubectl \
  --context "${KUBE_CONTEXT}" \
  --namespace "${CONTROLLER_NAMESPACE}" \
  get secret \
  --selector=sealedsecrets.bitnami.com/sealed-secrets-key=active \
  --output=json >"${keys_json}"

jq --exit-status '.items | length > 0' "${keys_json}" >/dev/null
jq --sort-keys '{
  vault_sealed_secrets_key_resources: [
    .items[]
    | {
        apiVersion: "v1",
        kind: "Secret",
        metadata: {
          labels: {
            "sealedsecrets.bitnami.com/sealed-secrets-key": "active"
          },
          name: .metadata.name,
          namespace: .metadata.namespace
        },
        type: .type,
        data: {
          "tls.crt": .data["tls.crt"],
          "tls.key": .data["tls.key"]
        }
      }
  ] | sort_by(.metadata.name)
}' "${keys_json}" >"${vault_plaintext}"
chmod 0600 "${vault_plaintext}"

kubeseal \
  --context "${KUBE_CONTEXT}" \
  --controller-name "${CONTROLLER_NAME}" \
  --controller-namespace "${CONTROLLER_NAMESPACE}" \
  --fetch-cert >"${current_certificate}"

current_public_key="$(
  openssl x509 -in "${current_certificate}" -pubkey -noout \
    | openssl pkey -pubin -outform DER \
    | openssl dgst -sha256
)"
backed_current_key=false
while IFS= read -r certificate_data; do
  backed_public_key="$(
    printf '%s' "${certificate_data}" \
      | base64 --decode \
      | openssl x509 -pubkey -noout \
      | openssl pkey -pubin -outform DER \
      | openssl dgst -sha256
  )"
  if [[ "${backed_public_key}" == "${current_public_key}" ]]; then
    backed_current_key=true
    break
  fi
done < <(jq --raw-output '.items[].data["tls.crt"]' "${keys_json}")

if [[ "${backed_current_key}" != true ]]; then
  echo "The controller's current certificate has no backed-up private key." >&2
  exit 1
fi

if [[ ! -f "${BACKUP_FILE}" ]] \
  || ! ansible-vault view --vault-password-file "${VAULT_PASSWORD_FILE}" "${BACKUP_FILE}" \
    | cmp --silent - "${vault_plaintext}"; then
  ansible-vault encrypt \
    --vault-password-file "${VAULT_PASSWORD_FILE}" \
    --encrypt-vault-id default \
    --output "${vault_ciphertext}" \
    "${vault_plaintext}"
  chmod 0600 "${vault_ciphertext}"
  mv -- "${vault_ciphertext}" "${BACKUP_FILE}"
fi

if [[ ! -f "${CERTIFICATE_FILE}" ]] \
  || ! cmp --silent "${current_certificate}" "${CERTIFICATE_FILE}"; then
  chmod 0644 "${current_certificate}"
  mv -- "${current_certificate}" "${CERTIFICATE_FILE}"
fi

key_count="$(jq '.items | length' "${keys_json}")"
certificate_fingerprint="$(
  openssl x509 -in "${CERTIFICATE_FILE}" -fingerprint -sha256 -noout | cut -d= -f2
)"
echo "Backed up ${key_count} Sealed Secrets keys."
echo "Current certificate SHA-256: ${certificate_fingerprint}"
