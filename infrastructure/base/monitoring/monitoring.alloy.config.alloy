logging {
  level  = "info"
  format = "logfmt"
}

import.file "metrics" {
  filename = "/etc/alloy/metrics.alloy"
}

import.file "logs" {
  filename = "/etc/alloy/logs.alloy"
}

import.file "traces" {
  filename = "/etc/alloy/traces.alloy"
}

metrics.pipeline "default" {}
logs.pipeline "default" {}
traces.pipeline "default" {}
